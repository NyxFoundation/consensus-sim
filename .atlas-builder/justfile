# Atlas Builder v1.0 — human-facing shortcuts for the standard operation commands.
#
# SUBJECT: the bound target project. Every recipe here is an OPERATION of the
# running framework. Recipes whose subject is Atlas Builder's OWN SOURCE (lint /
# format / fmt-check / test) live in the framework repository's root justfile, outside
# the shipped .atlas-builder/ directory — they would lint Atlas Builder's scripts, not
# your project (META.md §18.4, I-028).
#
# NOTE: This file is a convenience layer for the human operator. Agents may
# invoke only the diagnostic/state script entry points that settings + hooks
# explicitly permit, using their direct `bash scripts/...` / `bin/atlas-builder
# state ...` spellings. Human-only scripts stay denied even when
# invoked directly; a `just` indirection never grants authority.
#
# The [group] attributes are not decoration: they project the guard hook's three
# enforcement classes onto `just --list`, so the human sees the boundary at the
# discovery surface instead of having to read the guard decision tree (META.md §18.2).
#   human-only — the pre-tool guard hook DENIES these to agents (I-011/I-024): init /
#     trust / trust-check / doctor / new-essence / update-essence / once / loop / stop / resume / triage / supervise / watch. Flag-prefixed
#     `just` spellings are denied too; any spelling the hook does not recognize
#     still lands on the permissions default — no allow rule matches `just`, so
#     non-interactive cycles auto-deny it.
#   approval  — the hook ASKS: an agent may run it with explicit human approval.
#   inspect   — diagnostic / non-human transition; agents may run these. A
#     validate whose semantic diagnostics changed updates validation.json;
#     repeating the same result is byte-for-byte idempotent, and its entire
#     projection is serialized by the I-018 slot (META.md §20.5).
# `just state` spans classes by design: the hook classifies it per state
# subcommand (`state resume` is human-only, the loop-owned transitions are denied
# outright, the rest are allowed), so the recipe itself sits in `inspect` and the
# subcommand carries the boundary.
#
# Recipes run with CWD = this directory, so assert_control_root (I-002) holds.
#
# This file was generated by `just init` / init.sh from
# templates/control/justfile.tmpl. Re-run `just init <path>` to re-bind.

# Variadic recipes must not re-split quoted arguments (`just resume --note "two words"`
# has to reach the script as one --note value), so they take "$@" instead of {{args}}.
# Exception: `init` interpolates {{args}} because "$@" would re-include the leading
# `project` argument; its only extra flag, --force, is whitespace-free.
set positional-arguments

project := "../consensus-sim"

# List available recipes
default:
    @just --list

# Human-only: interview-driven authoring of a NEW ESSENCE.md — opens with an ideal-excavation (shackle-removal) phase, then asks the critical questions first, refines answers into verifiable wording, closes only when you declare the mutual understanding aligned, and installs the fully format-compliant draft only after you review the full text and confirm (y). Refuses when a real Essence already exists (use `just update-essence`) (META.md §2.1.4)
[group('human-only')]
new-essence:
    bash scripts/essence.sh --project {{quote(project)}} --mode new

# Human-only: interview-driven UPDATE of the existing ESSENCE.md — starts by asking your change intent, probes the ideal behind it and checks deferred 非対応事項 items whose promotion trigger is met, revises only what the intent touches (the rest carries forward verbatim), and installs the revised draft only after you review the full text + diff and confirm (y). Errors when no real Essence exists yet (use `just new-essence`) (META.md §2.1.4)
[group('human-only')]
update-essence:
    bash scripts/essence.sh --project {{quote(project)}} --mode update

# Human-only: bind this control plane to a project and bootstrap it, e.g. `just init ../my-project` (re-bind to another project: `just init ../other --force`)
[group('human-only')]
init project *args:
    bash scripts/init.sh --project {{quote(project)}} {{args}}

# Human-only: explicit setup step — mark only the CONTROL_ROOT launch-root candidates trusted in ~/.claude.json. PROJECT_ROOT itself is never pre-trusted (META.md §16)
[group('human-only')]
trust target=project:
    bash scripts/claude-trust.sh --project {{quote(target)}} --apply

# Human-only: run exactly one Atlas Builder cycle and create its checkpoint commit
[group('human-only')]
once:
    bash scripts/once.sh --project {{quote(project)}}

# Human-only: run the continuous loop (default 25-cycle cap; set with `-n N` / `--max-cycles N`, e.g. `just loop -n 5`); each executed cycle creates one checkpoint commit. While a stop gate is latched, the loop refuses side-effect-free — see `just status`, then `just resume` (META.md §13.4)
[group('human-only')]
loop *args:
    bash scripts/loop.sh --project {{quote(project)}} "$@"

# Human-only: ask the running loop to stop cleanly at the next cycle boundary (graceful drain) — the cycle in flight finishes and commits its checkpoint, then the loop exits without latching any gate, so plain `just loop` continues later with no resume needed (a stop gate latched in the same cycle still wins the final report). Asynchronous: watch the loop's terminal for the DRAIN line. Withdraw a pending request with `just stop --cancel` (META.md §19.1-7)
[group('human-only')]
stop *args:
    bash scripts/stop.sh --project {{quote(project)}} "$@"

# Human-only: interactive triage of the current stop gates — investigates and dispatches what needs no human decision, asks you the essential questions for the rest, presents step-by-step actions, drafts the resume note, and hands off to a y/N-confirmed `just resume`. Read-only; never implements (META.md §13.6)
[group('human-only')]
triage:
    bash scripts/triage.sh --project {{quote(project)}}

# Human-only: start a single-flight interactive Over-Project Agent session for one already-approved High-Risk Todo. The Todo ID is mandatory; pass its approval Recommendation when available. Review each permission prompt and the resulting diff; checkpoint it afterward with a targeted `just resume` (META.md §12.1, §21.3)
[group('human-only')]
supervise *args:
    bash scripts/supervise.sh --project {{quote(project)}} "$@"

# Human-only: record a human intervention — release the stop gates after a loop stop with exact `--resolve <ID>` flags, checkpoint your mid-course edits to ESSENCE.md without touching any gate (`--steer-only`, §13.3-4'''), or recover a crashed loop with --force. The intent note is mandatory: pass --note "..." or be prompted interactively; non-interactive runs without --note are refused (META.md §13.3, §13.5)
[group('human-only')]
resume *args:
    bash scripts/resume.sh --project {{quote(project)}} "$@"

# Needs human approval (agents: ask): idempotent re-initialization — runs inside `just init`, so the first setup never needs it; use it standalone to re-seed/repair (never overwrites existing files)
[group('approval')]
bootstrap:
    bash scripts/bootstrap.sh --project {{quote(project)}}

# Needs human approval (agents: ask): build the Lean 4 `atlas-builder` binary (lake build in lean/) and install it to bin/atlas-builder — bootstrap/operator step, not a per-cycle recipe (META.md §31)
[group('approval')]
build:
    cd lean && lake build
    mkdir -p bin
    install -m 755 lean/.lake/build/bin/atlas-builder bin/atlas-builder

# Human-only health check: inspects Claude trust/credential configuration, which an Agent is denied from reading by I-024
[group('human-only')]
doctor:
    bash scripts/doctor.sh --project {{quote(project)}}

# Human-readable state summary
[group('inspect')]
status:
    bash scripts/status.sh --project {{quote(project)}}

# Human-only: live read-only TUI over the running loop — join `just loop` from another terminal and watch the current cycle, gate state, run history/stats, and the agent's live tool activity, redrawn about every second. A pure observer: quitting (q / Ctrl-C) never touches the loop or canonical state, and it also works while no loop runs (last-known cycle display) (META.md §15.3)
[group('human-only')]
watch:
    bash scripts/watch.sh --project {{quote(project)}}

# Human-only: check Claude Code trust without writing ~/.claude.json — reading the credential/config file is still outside the Agent secret boundary (I-024)
[group('human-only')]
trust-check target=project:
    bash scripts/claude-trust.sh --project {{quote(target)}} --check

# Run a atlas-builder state command, e.g. `just state validate` (the boundary is per subcommand: `state resume` is human-only, the loop-owned transitions are denied to agents — META.md §18.2)
[group('inspect')]
state +args:
    bin/atlas-builder state "$@" --project {{quote(project)}}
